# Шаблон локального .env. Настоящий .env создаёт `scripts/setup.ps1` / `setup.sh`
# (или `uv run poe setup`) и подставляет в него твою базу, индекс Redis и SECRET_KEY.
# .env в git не попадает. Пароли ниже — только для разработки.

# ============================================================== Django
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Django admin — не на /admin/: путь знает только команда (03_security.md §8).
DJANGO_ADMIN_PATH=team-admin/

# ============================================================== подключение приложения
# Участник: a — Никита (core), b — учебная логика (domain), c — интерфейс (web).
DEV_PARTICIPANT=a

# Сервер БД общий, база у каждого своя: dekanat_a / dekanat_b / dekanat_c.
# Миграции из незаконченной ветки одного не ломают базу другого.
#   локально (Docker у себя или SSH-туннель к серверу):
DATABASE_URL=postgres://dekanat:dekanat-dev-password@127.0.0.1:5433/dekanat_a
#   удалённый сервер напрямую, с TLS:
# DATABASE_URL=postgres://dekanat:<пароль>@db.example.ru:5432/dekanat_b?sslmode=require

# Redis необязателен: пусто — кэш в памяти процесса, задачи Celery выполняются сразу.
# Индекс базы Redis тоже свой: a — 1, b — 2, c — 3 (0 — у стенда в Docker).
REDIS_URL=redis://:dekanat-dev-redis@127.0.0.1:6379/1

# ============================================================== сервер БД (docker compose)
# Нужно только тому, у кого запущены контейнеры PostgreSQL и Redis (`uv run poe db-up`).
# Пароли — только латиница, цифры и дефис: они вставляются в URL подключения.
POSTGRES_USER=dekanat
POSTGRES_PASSWORD=dekanat-dev-password
POSTGRES_DB=dekanat
DEV_DATABASES=dekanat_a,dekanat_b,dekanat_c
# 127.0.0.1 — порт виден только с этой машины. Для доступа коллег — SSH-туннель (см. PROJECT.md).
POSTGRES_BIND=127.0.0.1
# 5433, а не 5432: стандартный порт часто занят PostgreSQL, установленным в систему.
POSTGRES_PORT=5433
REDIS_PASSWORD=dekanat-dev-redis
REDIS_BIND=127.0.0.1
REDIS_PORT=6379
